{
  "name": "gdw-mirror",
  "productName": "GDW Mirror",
  "version": "0.2.3",
  "description": "Espejo de pantalla entre macOS y Windows, un sentido a la vez. / Screen mirroring between macOS and Windows, one direction at a time.",
  "keywords": [
    "screen-mirror",
    "screen-mirroring",
    "mirror-screen",
    "screen-sharing",
    "screen-cast",
    "mac-to-windows",
    "macos-to-windows",
    "second-screen",
    "display-mirroring",
    "remote-display",
    "extend-display",
    "presentation",
    "conference",
    "meet",
    "zoom",
    "obs",
    "webrtc",
    "electron",
    "macos",
    "windows",
    "lan",
    "low-latency",
    "no-drivers",
    "airplay-alternative",
    "sunshine-alternative",
    "espejo",
    "espejo-de-pantalla",
    "compartir-pantalla",
    "mac-a-windows"
  ],
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron . --mode=host",
    "dev": "electron . --mode=host --dev",
    "dist:mac": "electron-builder --config builder/dual.yml --mac dmg zip",
    "dist:win": "electron-builder --config builder/dual.yml --win nsis portable --x64"
  },
  "author": "José Cruz Chávez <https://josecruzchavez.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/josecruzchavez/gdw-mirror.git"
  },
  "homepage": "https://gdw.mx",
  "bugs": {
    "url": "https://github.com/josecruzchavez/gdw-mirror/issues"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
