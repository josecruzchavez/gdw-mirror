{
  "name": "gdw-mirror",
  "productName": "GDW Mirror Host",
  "version": "0.2.2",
  "description": "Espejo de pantalla (screen mirror) macOS → Windows por LAN. Comparte la pantalla de tu Mac en Meet, Zoom u OBS desde una PC, a resolución nativa. Sin control remoto, sin servicios, sin drivers.",
  "keywords": [
    "screen-mirror",
    "screen-mirroring",
    "mirror-screen",
    "screen-sharing",
    "screen-cast",
    "mac-to-windows",
    "macos-to-windows",
    "second-screen",
    "display-mirroring",
    "remote-display",
    "extend-display",
    "presentation",
    "conference",
    "meet",
    "zoom",
    "obs",
    "webrtc",
    "electron",
    "macos",
    "windows",
    "lan",
    "low-latency",
    "no-drivers",
    "airplay-alternative",
    "sunshine-alternative",
    "espejo",
    "espejo-de-pantalla",
    "compartir-pantalla",
    "mac-a-windows"
  ],
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "host": "electron . --mode=host",
    "viewer": "electron . --mode=viewer",
    "dev:host": "electron . --mode=host --dev",
    "dev:viewer": "electron . --mode=viewer --dev",
    "dist:mac": "electron-builder --config builder/host.yml --mac zip",
    "dist:mac:dmg": "electron-builder --config builder/host.yml --mac dmg",
    "dist:win": "electron-builder --config builder/viewer.yml --win portable --x64",
    "dist:win:zip": "electron-builder --config builder/viewer.yml --win zip --x64"
  },
  "author": "José Cruz Chávez <https://josecruzchavez.com>",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/josecruzchavez/gdw-mirror.git"
  },
  "homepage": "https://gdw.mx",
  "bugs": {
    "url": "https://github.com/josecruzchavez/gdw-mirror/issues"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
